# Supabase (sponsorship tracker + future student-data backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic (assistant chat)
ANTHROPIC_API_KEY=

# Resend (Family Portal magic links + Rob review alerts + broadcasts + sponsor cold sends)
RESEND_API_KEY=
PORTAL_EMAIL_FROM=Ashley Bands <portal@director.ashleybands.com>
PORTAL_REVIEW_TO=
PORTAL_SESSION_SECRET=
# Dedicated HMAC key for protected Infinite Campus student identifiers.
ATTENDANCE_IDENTIFIER_SECRET=
# One-way bcrypt hash of the shared Band Camp attendance PIN.
ATTENDANCE_PIN_HASH=
# Sponsor cold-outreach sender (must be on the verified Resend domain). Replies route
# to the director. Defaults are used if unset; override per environment if needed.
SPONSOR_EMAIL_FROM=Ashley Bands Sponsorships <sponsorship@director.ashleybands.com>
SPONSOR_EMAIL_REPLY_TO=robert.parker@nhcs.net

# PayPal (student fee payments). Use sandbox creds first, flip PAYPAL_ENV=live to go live.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Same value as PAYPAL_CLIENT_ID — exposed to the browser for the Pay-online button.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
